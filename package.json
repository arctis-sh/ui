{
  "name": "@arctis-sh/ui",
  "version": "0.2.1",
  "description": "A starting point for your design system",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "ui": "./cli/index.mjs"
  },
  "files": [
    "dist",
    "src/styles",
    "registry",
    "cli"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./styles/typeset.css": "./src/styles/typeset.css",
    "./styles/*": "./src/styles/*",
    "./*": {
      "import": "./dist/*.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arctis-sh/ui.git"
  },
  "bugs": {
    "url": "https://github.com/arctis-sh/ui/issues"
  },
  "homepage": "https://github.com/arctis-sh/ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:registry": "node scripts/build-registry.mjs",
    "prepublishOnly": "npm run build:registry && npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-table": "^8.21.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
